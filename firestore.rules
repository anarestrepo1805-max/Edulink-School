rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Registered email lookup for registration validation
    match /registered_emails/{emailDoc} {
      allow read: if true;
      allow write: if true;
    }

    // Pre-authorized institutional verification codes for role validation (Teacher/Admin)
    match /authorized_roles/{codeDoc} {
      allow read: if true;
      allow write: if true;
    }

    // Password reset tokens and requests
    match /password_resets/{resetDoc} {
      allow read: if true;
      allow write: if true;
    }

    // Registered document ID lookup
    match /registered_documents/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Claimed / used role codes to prevent reuse
    match /used_role_codes/{codeDoc} {
      allow read: if true;
      allow write: if true;
    }

    // Institutional assignments published by teachers
    match /assignments/{assignmentId} {
      allow read: if true;
      allow write: if true;
    }

    // Student task submissions
    match /submissions/{submissionId} {
      allow read: if true;
      allow write: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }
  }
}
