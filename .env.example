# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required for sending real password recovery emails via Resend.
# Configure this in the Secrets panel in AI Studio or in your environment variables.
RESEND_API_KEY="re_123456789_abcdefg"

# RESEND_FROM_EMAIL: Sender address (optional).
# Defaults to: "EDULINK SCHOOL <onboarding@resend.dev>" during testing.
# For production with verified domain: "EDULINK SCHOOL <soporte@tudominio.com>"
RESEND_FROM_EMAIL="EDULINK SCHOOL <onboarding@resend.dev>"

# EmailJS Service Configuration (optional fallback)
VITE_EMAILJS_SERVICE_ID="service_edulink"
VITE_EMAILJS_TEMPLATE_ID="template_recovery"
VITE_EMAILJS_PUBLIC_KEY="YOUR_EMAILJS_PUBLIC_KEY"
