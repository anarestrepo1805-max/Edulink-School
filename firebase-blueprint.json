{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Registered user in Edulink School",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "teacher", "family", "admin"] },
        "createdAt": { "type": "string" },
        "hasConfigured": { "type": "boolean" },
        "institution": { "type": "string" }
      },
      "required": ["id", "email", "fullName", "role"]
    },
    "UserSubject": {
      "title": "User Subject",
      "description": "Subject configured by a student or teacher",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "teacher": { "type": "string" },
        "code": { "type": "string" },
        "schedule": { "type": "string" },
        "grade": { "type": "number" },
        "progress": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "RegisteredEmail": {
      "title": "Registered Email Index",
      "description": "Index of registered user emails to verify registration status",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "registeredAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "AuthorizedRoleVerification": {
      "title": "Authorized Role Verification",
      "description": "Pre-authorized institutional verification codes for teachers and administrators",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "role": { "type": "string", "enum": ["teacher", "admin"] },
        "department": { "type": "string" },
        "issuer": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["code", "role", "active"]
    },
    "PasswordReset": {
      "title": "Password Reset Request",
      "description": "Pending password reset requests with verification code",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "code": { "type": "string" },
        "requestedAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["email", "code", "expiresAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles"
    },
    "/users/{userId}/subjects/{subjectId}": {
      "schema": "UserSubject",
      "description": "Subjects configured by user"
    },
    "/registered_emails/{emailDoc}": {
      "schema": "RegisteredEmail",
      "description": "Lookup table of registered email addresses"
    },
    "/authorized_roles/{codeId}": {
      "schema": "AuthorizedRoleVerification",
      "description": "Pre-authorized institutional verification codes"
    },
    "/password_resets/{resetId}": {
      "schema": "PasswordReset",
      "description": "Temporary password reset requests and verification codes"
    }
  }
}
